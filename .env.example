# Copy to .env (git-ignored). Read by the server at request time; never sent to the browser.
# Home Assistant base URL as seen from the app container.
HA_BASE_URL=http://host.docker.internal:8123
# Long-lived access token (HA profile page). If empty the UI runs in demo mode.
HA_TOKEN=
# Immich server and API key. If IMMICH_API_KEY is empty the bundled sample photo is used.
IMMICH_URL=http://100.125.35.82:2283
IMMICH_API_KEY=
# Shared secret: header X-Bridge-Token, ?token=, or path prefix /<token>/screen.png
BRIDGE_TOKEN=change-me
# UI language: he (default, right-to-left) or en. Read per request, so a container restart is enough.
UI_LANGUAGE=he
# --- Media (amp, radio, Jellyfin). All optional: without them the media screens show demo data. ---
# Yamaha R-N500 IP/host as seen from the app container: XML API on :80, UPnP AVTransport on :8080.
AMP_HOST=192.168.1.25
# Jellyfin server, an API key (Dashboard > API Keys) and the id of the user whose library is played.
JELLYFIN_URL=http://192.168.1.15:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
# YTuner (NET RADIO backend) as seen from the app container; the compose service name is the default.
YTUNER_URL=http://ytuner
# Where the playback queue / last source / radio position JSON is kept (default: the OS temp dir).
MEDIA_STATE_DIR=/data
# Disk cache for resized grayscale logos and album art (default: <tmp>/kindle-media-cache).
MEDIA_CACHE_DIR=/data/media-cache
# Host directory for the containers' runtime state (docker-compose.yml bind-mounts <dir>/app-data -> /data and
# <dir>/ytuner-{db,cache,config}). Default ./data next to docker-compose.yml; point it at a backed-up location.
#KINDLE_DATA_DIR=/srv/data/kindle-home-nexus
# --- Voice bridge (/api/voice/*): Home Assistant Assist calls play/action/radio/search and polls /state. ---
# Bearer token; empty = the voice endpoints answer 503. Generate: openssl rand -hex 24. Same value goes into
# HA's secrets.yaml (voice_token).
VOICE_TOKEN=
# --- Station art: stations whose catalogue logo is missing or not a real image get a generated placeholder cover ---
# from cover-forge (github.com/lirankor/cover-forge; a separate compose project on this box whose docker network the
# app joins, see docker-compose.yml). Empty URL = no generated covers (HA shows its placeholder, the Kindle a glyph).
COVER_FORGE_URL=http://cover-forge:8793
COVER_FORGE_TOKEN=
# --- Kindle battery saver (docs/battery-saver-plan.md). The device never suspends (a button cannot wake a suspended
# Kindle 4): while the app shows its screensaver and nothing is in use it switches its Wi-Fi radio off between
# updates. By day one update every DAY_WAKE_MIN minutes (new photo + readings; also the photo rotation period), at
# night (NIGHT_START–NIGHT_END local time in SLEEP_TZ, DST-aware) every NIGHT_WAKE_MIN minutes with NO photo change.
# The bridge computes the update times (the Kindle's clock is UTC and has no tz data).
# RADIO_DUTY_ENABLED=0 = the radio stays up around the clock (server-side kill switch).
RADIO_DUTY_ENABLED=1
DAY_WAKE_MIN=10
NIGHT_START=00:00
NIGHT_END=06:00
NIGHT_WAKE_MIN=120
SLEEP_TZ=Europe/Berlin
