# Kindle Home Nexus client config (POSIX sh, UNIX line endings)
BRIDGE_URL="http://192.168.1.15:8790"   # pop-os bridge (docker)
POLL_SECONDS=20                            # how often to re-fetch the screen when idle (the bridge shortens/lengthens it: 5 s music, 60 s screensaver)
STOP_FRAMEWORK=1                           # 1 = stop the Kindle reader UI while running (frees RAM, frees buttons)
BRIDGE_TOKEN=""                           # must match BRIDGE_TOKEN in the server .env
FULL_REFRESH_EVERY=0                      # 0 = full (flashing) refresh only when the app asks (screen/page/song change) or on tab keys; N>0 adds one every N drawn frames
FLIP_SIDE_BUTTONS=1                       # 1 = upper side buttons go to the next tab (RTL layout), 0 = previous
FETCH_TIMEOUT=15                          # hard timeout (s) for every bridge call; the stock wget has no -T
FAIL_HINT_AFTER=3                         # draw the "bridge unreachable" footer after N consecutive failed fetches
CPU_GOVERNOR=ondemand                     # set at start when the kernel offers it (idles at 160 MHz); empty = leave the stock "performance"
BATTERY_EVERY=60                          # report the battery to the bridge at most every N s
# --- battery saver: the device never suspends; it switches the Wi-Fi RADIO off between updates while the
# --- screensaver shows and nothing is in use (docs/battery-saver-plan.md).
RADIO_DUTY=1                              # KILL SWITCH: 0 = radio always on (needs a restart); `touch /mnt/us/nexus/NORADIO` does the same live
MIN_DOZE=60                               # do not bother switching the radio off for less than this (s)
MAX_DOZE=7800                             # ... or for longer than this (s): the 2-hourly night window plus headroom
KEY_HOLD=300                              # a hardware button within the last N s keeps the radio up (same 5 min as the app's screensaver)
WIFI_WAIT=30                              # max s to wait for wifid CONNECTED after switching the radio back on (6 s measured)
RADIO_FAIL_HOLD=900                       # radio refused to re-associate: leave it on and stop duty cycling for N s
EINK_SETTLE=2                             # s to let the e-ink controller finish the (full) draw before anything else happens
DOZE_OVERRIDE=                            # rollout test only: a fixed window length in s (e.g. 120) instead of the bridge schedule; empty = schedule
DOZE_OVERRIDE_CYCLES=3                    # ... for this many windows after a start, then the schedule applies
