# Kindle Home Nexus client config (POSIX sh, UNIX line endings)
BRIDGE_URL="http://192.168.1.15:8790"   # pop-os bridge (docker)
POLL_SECONDS=20                            # how often to re-fetch the screen when idle
STOP_FRAMEWORK=1                           # 1 = stop the Kindle reader UI while running (frees RAM, frees buttons)
BRIDGE_TOKEN=""                           # must match BRIDGE_TOKEN in the server .env
